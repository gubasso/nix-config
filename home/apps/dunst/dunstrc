[global]
    monitor = 0
    follow = mouse

    width = (300, 400)
    height = 300
    origin = top-right
    offset = 20x20
    notification_limit = 5

    progress_bar = true
    indicate_hidden = true

    padding = 12
    horizontal_padding = 16
    text_icon_padding = 16
    frame_width = 2
    gap_size = 4
    separator_color = frame
    # Colors (frame_color + per-urgency bg/fg) are theme-driven; see the
    # generated dunstrc.d/zzz-theme.conf drop-in (nix-config lib/theme).

    font = monospace 10
    markup = full
    format = "<b>%s</b>\n%b"
    alignment = left
    show_age_threshold = 30
    ellipsize = end

    icon_position = left
    max_icon_size = 48

    corner_radius = 4

    mouse_left_click = close_current
    mouse_right_click = close_all
    mouse_middle_click = do_action

[urgency_low]
    timeout = 5

[urgency_normal]
    timeout = 10

[urgency_critical]
    timeout = 0
