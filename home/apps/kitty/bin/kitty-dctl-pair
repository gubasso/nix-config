#!/usr/bin/env bash
# Launch a kitty tab with side-by-side dctl agent panes (claude-session + codex)
set -euo pipefail

die() {
  printf '\033[1;31mERROR:\033[0m %s\n' "$1" >&2
  exit 1
}

[[ -n "${KITTY_LISTEN_ON:-}" ]] || die "Not running inside kitty (KITTY_LISTEN_ON not set)"

cwd="$(pwd)"

kitten @ launch --type=tab --tab-title agents --cwd="$cwd" dctl ws shell claude-session
kitten @ launch --location=vsplit --cwd="$cwd" --dont-take-focus
