# Inherit system defaults
$include /etc/inputrc

# -- Completion behavior --
set show-all-if-ambiguous on
set show-all-if-unmodified on
set colored-stats on
set colored-completion-prefix on
set visible-stats on
set mark-symlinked-directories on
set completion-ignore-case on
set completion-map-case on

# Tab cycles through completions (like zsh); overridden by bind -x in
# 10-fzf.bash when fzf-tab-completion is available.
TAB: menu-complete
"\e[Z": menu-complete-backward

# -- History --
# Type partial command then arrow up/down to search history matching prefix
"\e[A": history-search-backward
"\e[B": history-search-forward

# -- Editing --
# Vi editing mode (was `set -o vi` in bebash 00-options.bash). The vi-mode
# prompt strings and vi-keymap binds live in shell-core initExtra and are inert
# without this.
set editing-mode vi
set bell-style none
set enable-bracketed-paste on

# Skip whole words with Ctrl+Left/Right
"\e[1;5C": forward-word
"\e[1;5D": backward-word
