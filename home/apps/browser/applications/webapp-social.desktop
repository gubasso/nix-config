[Desktop Entry]
Type=Application
Name=WebApp Social
Comment=Social media (Whatsapp, X, LinkedIn, etc.)
Exec=brave-launcher --class=brave-social --new-window --profile-directory=Social %U
Terminal=false
Categories=Network;WebBrowser;
Keywords=social;whatsapp;twitter;x;linkedin;facebook;instagram;messenger;chat;
StartupNotify=true
StartupWMClass=brave-social
Actions=new-window;new-private-window;
Icon=webapp-social

[Desktop Action new-window]
Name=New Window
Exec=brave-launcher --class=brave-social --new-window --profile-directory=Social

[Desktop Action new-private-window]
Name=New Incognito Window
Exec=brave-launcher --class=brave-social --new-window --profile-directory=Social --incognito
