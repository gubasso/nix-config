[Desktop Entry]
Type=Application
Name=WebApp AI
Comment=AI assistants (Gemini, ChatGPT, Claude, etc.)
Exec=brave-launcher --class=brave-ai --new-window --profile-directory=AI %U
Terminal=false
Categories=Network;WebBrowser;
Keywords=ai;artificial intelligence;chatgpt;claude;gemini;llm;assistant;chat;
StartupNotify=true
StartupWMClass=brave-ai
Actions=new-window;new-private-window;
Icon=webapp-ai

[Desktop Action new-window]
Name=New Window
Exec=brave-launcher --class=brave-ai --new-window --profile-directory=AI

[Desktop Action new-private-window]
Name=New Incognito Window
Exec=brave-launcher --class=brave-ai --new-window --profile-directory=AI --incognito
