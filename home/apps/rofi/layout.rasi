/*
  Canonical rofi layout — shared by every theme. Colors are NOT defined here;
  they arrive from the active theme's generated color block (see
  home/apps/rofi/default.nix, which prepends lib/theme's mkRofiColors and then
  @imports this file). Only the palette changes per theme; this layout is stable.

  Canonical color variables expected in scope: @bg @surface @overlay @muted @fg
  @accent @border @error.
*/

window {
  location: center;
  anchor: center;
  fullscreen: false;
  width: 42%;
  padding: 18px;
  border: 2px;
  border-color: @overlay;
  border-radius: 10px;
  background-color: @surface;
}

mainbox {
  spacing: 12px;
  children: [ inputbar, message, listview ];
}

message {
  padding: 8px 10px;
  border-radius: 6px;
  border: 1px;
  border-color: @overlay;
  background-color: @bg;
  text-color: @muted;
}

inputbar {
  children: [ prompt, entry ];
  spacing: 14px;
  padding: 8px 10px;
  border: 1px;
  border-color: @overlay;
  border-radius: 6px;
  background-color: @bg;
}

prompt {
  text-color: @accent;
}

entry {
  text-color: @fg;
  placeholder: "Search...";
  placeholder-color: @muted;
}

listview {
  columns: 1;
  lines: 9;
  spacing: 6px;
  scrollbar: true;
  padding: 2px 0 0;
  dynamic: false;
}

element {
  padding: 8px 10px;
  border-radius: 6px;
  background-color: transparent;
  text-color: @fg;
}

element normal normal {
  text-color: @fg;
}

element active {
  text-color: @fg;
  background-color: @surface;
  border: 1px;
  border-color: @overlay;
}

element urgent {
  text-color: @error;
  background-color: @surface;
  border: 1px;
  border-color: @error;
}

element selected {
  text-color: @fg;
  background-color: @overlay;
  border: 1px;
  border-color: @accent;
}

element-icon {
  size: 24px;
  margin: 0 10px 0 0;
  background-color: inherit;
  text-color: inherit;
}

element-text {
  background-color: inherit;
  text-color: inherit;
}

scrollbar {
  handle-width: 8px;
  handle-color: @accent;
  background-color: @bg;
}

mode-switcher {
  spacing: 8px;
}

button {
  padding: 6px 10px;
  border-radius: 6px;
  background-color: @surface;
  text-color: @muted;
}

button selected {
  background-color: @accent;
  text-color: @bg;
}
