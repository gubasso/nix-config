/*
  dwm launcher. DPI is inherited from the X server (Xft.dpi, set per-context by
  ~/.xinitrc from home/apps/graphics/default.nix), so one config renders right on
  every host and in the VM. dpi: 0 = take DPI from X.
*/

configuration {
  dpi: 0;
  modes: "window,drun,run,ssh";
  display-window: "Select:";
  display-drun: "";
  drun-display-format: "{icon} {name} [<span weight='light' size='small'><i>({generic})</i></span>]";
  case-sensitive: false;
  show-icons: true;

  timeout {
    action: "kb-cancel";
    delay: 0;
  }
  filebrowser {
    directories-first: true;
    sorting-method: "name";
  }
}

/* Theme = the generated active theme (from hostSettings.theme; see
   home/apps/rofi/default.nix + lib/theme). */
@theme "~/.local/state/rofi/active-theme.rasi"

/* Point size scales with the inherited DPI, so one value fits all contexts. */
* {
  font: "IBM Plex Mono 10";
}
