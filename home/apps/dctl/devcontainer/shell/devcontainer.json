{
  "mounts": [
    {
      "source": "${localEnv:HOME}/.config/environment.d",
      "target": "${localEnv:HOME}/.config/environment.d",
      "type": "bind"
    },
    {
      "source": "${localEnv:HOME}/.bashrc",
      "target": "${localEnv:HOME}/.bashrc",
      "type": "bind"
    },
    {
      "source": "${localEnv:HOME}/.bash_profile",
      "target": "${localEnv:HOME}/.bash_profile",
      "type": "bind"
    },
    {
      "source": "${localEnv:HOME}/.inputrc",
      "target": "${localEnv:HOME}/.inputrc",
      "type": "bind"
    },
    {
      "source": "${localEnv:HOME}/.config/bebash",
      "target": "${localEnv:HOME}/.config/bebash",
      "type": "bind",
      "readonly": true
    },
    {
      "source": "${localEnv:HOME}/.local/share/bebash",
      "target": "${localEnv:HOME}/.local/share/bebash",
      "type": "bind",
      "readonly": true
    }
  ]
}
