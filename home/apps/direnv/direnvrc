# shellcheck shell=bash
# ~/.config/direnv/direnvrc
# Wire nix-direnv's `use flake` without home-manager. nix-direnv is installed into
# the host user Nix profile from ~/.config/nix/host-flake. XDG profile
# (~/.local/state/nix/profile) first, legacy ~/.nix-profile as a fallback. Guarded
# so a pre-install shell doesn't error.
for d in \
  "${XDG_STATE_HOME:-$HOME/.local/state}/nix/profile/share/nix-direnv/direnvrc" \
  "$HOME/.nix-profile/share/nix-direnv/direnvrc"; do
  if [ -e "$d" ]; then
    # shellcheck source=/dev/null
    source "$d"
    break
  fi
done
