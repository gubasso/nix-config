/* Catppuccin Mocha */
* {
  rosewater: #f5e0dc;
  flamingo: #f2cdcd;
  pink: #f5c2e7;
  mauve: #cba6f7;
  red: #f38ba8;
  maroon: #eba0ac;
  peach: #fab387;
  yellow: #f9e2af;
  green: #a6e3a1;
  teal: #94e2d5;
  sky: #89dceb;
  sapphire: #74c7ec;
  blue: #89b4fa;
  lavender: #b4befe;
  text: #cdd6f4;
  subtext1: #bac2de;
  subtext0: #a6adc8;
  overlay2: #9399b2;
  overlay1: #7f849c;
  overlay0: #6c7086;
  surface2: #585b70;
  surface1: #45475a;
  surface0: #313244;
  base: #1e1e2e;
  mantle: #181825;
  crust: #11111b;

  background-color: transparent;
  text-color: @text;
}

window {
  location: center;
  anchor: center;
  fullscreen: false;
  width: 42%;
  padding: 18px;
  border: 2px;
  border-color: @surface2;
  border-radius: 10px;
  background-color: @base;
}

mainbox {
  spacing: 12px;
}

inputbar {
  children: [prompt, entry];
  spacing: 14px;
  padding: 8px 10px;
  border: 1px;
  border-color: @surface1;
  border-radius: 6px;
  background-color: @mantle;
}

prompt {
  text-color: @mauve;
}

entry {
  text-color: @text;
  placeholder: "Search...";
  placeholder-color: @overlay0;
}

listview {
  columns: 1;
  lines: 9;
  spacing: 6px;
  scrollbar: true;
  padding: 2px 0 0;
}

element {
  padding: 8px 10px;
  border-radius: 6px;
  background-color: transparent;
}

element normal {
  text-color: @text;
}

element active {
  text-color: @text;
  background-color: @surface0;
  border: 1px;
  border-color: @surface1;
}

element urgent {
  text-color: @red;
  background-color: @surface0;
  border: 1px;
  border-color: @red;
}

element selected {
  text-color: @crust;
  background-color: @mauve;
  border: 1px;
  border-color: @lavender;
}

element-icon {
  size: 24px;
  margin: 0 10px 0 0;
}

element-text {
  text-color: inherit;
}

scrollbar {
  handle-width: 8px;
  handle-color: @surface2;
  background-color: @mantle;
}

mode-switcher {
  spacing: 8px;
}

button {
  padding: 6px 10px;
  border-radius: 6px;
  background-color: @mantle;
  text-color: @subtext1;
}

button selected {
  background-color: @mauve;
  text-color: @crust;
}
