#!/usr/bin/env bash
# Launch dctl agent panes with Vertex AI (--profile suse) claude-session
set -euo pipefail

die() {
  printf '\033[1;31mERROR:\033[0m %s\n' "$1" >&2
  exit 1
}
[[ -n "${KITTY_LISTEN_ON:-}" ]] || die "Not running inside kitty (KITTY_LISTEN_ON not set)"

cwd="$(pwd)"
kitten @ launch --type=tab --tab-title agents-suse --cwd="$cwd" \
  bash -c 'printf "\033[1;33m▸ vertex mode (claude-session --profile suse)\033[0m\n"; exec dctl ws shell claude-session --profile suse'
kitten @ launch --location=vsplit --cwd="$cwd" --dont-take-focus
