#!/bin/bash
# Generic help overlay for kitty keyboard modes.
# Extracts the header comment block from a kitty mode .conf file.
# Usage: kitty-mode-help <conf-filename>

conf="$HOME/.config/kitty/${1:?usage: kitty-mode-help <conf-file>}"

if [[ ! -f "$conf" ]]; then
  echo "File not found: $conf" >&2
  read -r -n1 _
  exit 1
fi

# Extract lines between first and last # ===... delimiters (exclusive),
# strip the leading "# " or "#" prefix.
awk '
    /^# =+/ {
        if (buf != "") print buf
        buf = ""
        started = 1
        next
    }
    started {
        sub(/^# ?/, "")
        buf = (buf == "") ? $0 : buf "\n" $0
    }
' "$conf"

read -r -n1 _
