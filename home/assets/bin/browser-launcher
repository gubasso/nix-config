#!/usr/bin/env bash
# browser-launcher - Cached launcher for Chromium-based browsers
#
# Usage:
#   browser-launcher <browser> [browser-args...]
#
# Env overrides:
#   BRAVE_CMD / BRAVE_NOCACHE
#   CHROMIUM_CMD / CHROMIUM_NOCACHE

set -euo pipefail
shopt -s nullglob

usage() {
  cat <<'USAGE'
Usage: browser-launcher <browser> [browser-args...]

Examples:
  browser-launcher brave --new-window
  browser-launcher chromium --incognito

Supported browsers:
  brave, chromium

Env overrides:
  BRAVE_CMD, BRAVE_NOCACHE
  CHROMIUM_CMD, CHROMIUM_NOCACHE
USAGE
}

if [[ "${1:-}" == "--help" || "${1:-}" == "-h" ]]; then
  usage
  exit 0
fi

if [[ $# -lt 1 || "${1:0:1}" == "-" ]]; then
  usage >&2
  exit 1
fi

BROWSER="${1,,}"
shift

if [[ ! "$BROWSER" =~ ^[a-z][a-z0-9._-]*$ ]]; then
  echo "Unsupported browser name: '$BROWSER'" >&2
  usage >&2
  exit 1
fi

VAR_PREFIX=$(printf '%s' "$BROWSER" | tr '[:lower:]-.' '[:upper:]__')
CMD_VAR="${VAR_PREFIX}_CMD"
NOCACHE_VAR="${VAR_PREFIX}_NOCACHE"

SHARED_CONFIG="${XDG_CONFIG_HOME:-$HOME/.config}/browser"

CACHE_DIR="${XDG_CACHE_HOME:-$HOME/.cache}/browser-launcher/$BROWSER"
CACHE_EXEC="$CACHE_DIR/exec.sh"
CACHE_BIN="$CACHE_DIR/binary"
CACHE_STAMP="$CACHE_DIR/stamp"
CACHE_MANIFEST="$CACHE_DIR/manifest"

SHARED_FLAGS_DIR="$SHARED_CONFIG/flags.d"
ENV_FILE="$SHARED_CONFIG/env.sh"

flatpak_id() {
  case "$BROWSER" in
    brave) echo "com.brave.Browser" ;;
    chromium) echo "org.chromium.Chromium" ;;
    *) return 1 ;;
  esac
}

stat_mtime() {
  stat -c '%n:%Y' "$1" 2>/dev/null || stat -f '%N:%m' "$1" 2>/dev/null
}

build_manifest() {
  {
    [[ -f "$ENV_FILE" ]] && stat_mtime "$ENV_FILE"

    if [[ -d "$SHARED_FLAGS_DIR" ]]; then
      for conf in "$SHARED_FLAGS_DIR"/*.conf; do
        [[ -f "$conf" ]] || continue
        stat_mtime "$conf"
      done
    fi
  } | sort
}

cache_is_fresh() {
  [[ -x "$CACHE_EXEC" && -r "$CACHE_STAMP" && -r "$CACHE_BIN" && -r "$CACHE_MANIFEST" ]] || return 1

  local bin
  bin=$(<"$CACHE_BIN")
  case "$bin" in
    FLATPAK) ;;
    BROWSER_CMD)
      return 1
      ;;
    *)
      [[ -x "$bin" ]] || return 1
      ;;
  esac

  local current_manifest cached_manifest
  current_manifest=$(build_manifest)
  cached_manifest=$(<"$CACHE_MANIFEST")
  [[ "$current_manifest" == "$cached_manifest" ]] || return 1

  return 0
}

try_bin() {
  local candidate="$1"
  command -v "$candidate" >/dev/null 2>&1 || return 1
  command -v "$candidate"
}

try_flatpak() {
  local app_id="$1"
  command -v flatpak >/dev/null 2>&1 || return 1
  flatpak info "$app_id" >/dev/null 2>&1 || return 1
  printf 'FLATPAK'
}

resolve_binary() {
  if [[ -n "${!CMD_VAR:-}" ]]; then
    echo "BROWSER_CMD"
    return 0
  fi

  case "$BROWSER" in
    brave)
      try_bin brave-browser-stable || try_bin brave-browser || try_bin brave || try_flatpak "com.brave.Browser"
      ;;
    chromium)
      try_bin chromium || try_bin chromium-browser || try_flatpak "org.chromium.Chromium"
      ;;
    *)
      try_bin "$BROWSER"
      ;;
  esac
}

parse_file() {
  local file="$1"
  while IFS= read -r line || [[ -n "$line" ]]; do
    line="${line#"${line%%[![:space:]]*}"}"
    [[ -z "$line" || "${line:0:1}" == "#" ]] && continue
    printf '%s\n' "$line"
  done <"$file"
}

parse_flags() {
  if [[ -d "$SHARED_FLAGS_DIR" ]]; then
    for conf in "$SHARED_FLAGS_DIR"/*.conf; do
      [[ -f "$conf" ]] || continue
      parse_file "$conf"
    done
  fi
}

rebuild_cache() {
  mkdir -p "$CACHE_DIR"

  local binary
  binary=$(resolve_binary) || {
    echo "Could not find browser binary for '$BROWSER'." >&2
    exit 1
  }

  local -a flags=()
  if [[ "$BROWSER" == "brave" ]]; then
    flags+=("--user-data-dir=${XDG_CONFIG_HOME:-$HOME/.config}/BraveSoftware/Brave-Browser")
  fi

  while IFS= read -r flag; do
    [[ -n "$flag" ]] && flags+=("$flag")
  done < <(parse_flags)

  {
    echo '#!/bin/sh'
    echo '# Auto-generated by browser-launcher - DO NOT EDIT'
    printf '# Browser: %s\n' "$BROWSER"
    printf '# Regenerate: %s=1 browser-launcher %s\n' "$NOCACHE_VAR" "$BROWSER"
    echo ''

    if [[ -f "$ENV_FILE" ]]; then
      printf 'ENV_FILE=%q\n' "$ENV_FILE"
      echo 'if [ -f "$ENV_FILE" ]; then'
      echo '  # shellcheck source=/dev/null'
      echo '  . "$ENV_FILE"'
      echo 'fi'
      echo ''
    fi

    case "$binary" in
      FLATPAK)
        # NOTE: Flatpak sandboxing may override VK_DRIVER_FILES, VK_ICD_FILENAMES,
        # and VK_LAYER_PATH set by env.sh. Vulkan-disable strategy may need
        # flatpak run --env= overrides if Flatpak is used as primary install.
        local app_id
        app_id=$(flatpak_id) || {
          echo "Unsupported browser for flatpak: $BROWSER" >&2
          exit 1
        }
        printf 'exec flatpak run %q' "$app_id"
        ;;
      BROWSER_CMD)
        printf 'exec "${%s}"' "$CMD_VAR"
        ;;
      *)
        printf 'exec %q' "$binary"
        ;;
    esac

    for flag in "${flags[@]}"; do
      printf ' \\\n  %q' "$flag"
    done

    printf ' \\\n  "$@"\n'
  } >"$CACHE_EXEC.tmp"

  chmod +x "$CACHE_EXEC.tmp"
  mv -f "$CACHE_EXEC.tmp" "$CACHE_EXEC"

  echo "$binary" >"$CACHE_BIN"
  build_manifest >"$CACHE_MANIFEST"
  : >"$CACHE_STAMP"
}

if [[ "${!NOCACHE_VAR:-0}" != "1" ]] && cache_is_fresh; then
  exec "$CACHE_EXEC" "$@"
fi

rebuild_cache
exec "$CACHE_EXEC" "$@"
