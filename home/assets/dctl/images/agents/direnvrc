# shellcheck shell=bash
# ~/.config/direnv/direnvrc — baked into the agents image.
# Wire nix-direnv's `use flake` without home-manager. nix-direnv is installed
# into the global nix profile by nix-bootstrap.sh; guard so a pre-bootstrap
# shell doesn't error. XDG profile (~/.local/state/nix/profile) first, legacy
# ~/.nix-profile as a fallback.
for d in \
  "${XDG_STATE_HOME:-$HOME/.local/state}/nix/profile/share/nix-direnv/direnvrc" \
  "$HOME/.nix-profile/share/nix-direnv/direnvrc"; do
  if [ -e "$d" ]; then
    # shellcheck source=/dev/null
    source "$d"
    break
  fi
done
