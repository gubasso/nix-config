// =============================================================================
// GEMINI LAYER — Google Gemini CLI host state
// =============================================================================
//
// 1:1 host bind for `~/.gemini`. The host is assumed set up (the user's
// own live Gemini state already exists at this path), so host and
// container see the same files without anything running inside.
// =============================================================================
{
  "mounts": [
    {
      "source": "${localEnv:HOME}/.gemini",
      "target": "${localEnv:HOME}/.gemini",
      "type": "bind"
    }
  ]
}
