// =============================================================================
// CODEX LAYER — OpenAI Codex CLI + host wrapper (codex-session)
// =============================================================================
//
// Single layer covering both the underlying CLI's live state and the
// host `codex-session` wrapper's XDG paths. They are bundled here
// because every container that wants Codex needs both — the wrapper
// drives the underlying CLI and has no value on its own.
//
// All mounts are 1:1 host binds (same path inside and outside the
// container) so any tool that reads/writes these paths Just Works
// without an env override. The host is assumed set up — `dots codex` /
// `dots codex-session` (or equivalents) have already materialized the
// paths under HOME.
//
// CODEX CLI live state
//   ~/.codex  — auth.json, sessions, logs, installation_id, config.toml.
//               The codex-session wrapper's auth bridge
//               (src/services/auth.rs) reads/writes `~/.codex/auth.json`
//               under a flock at `~/.codex/.auth.json.lock`, polling
//               every 500 ms to keep host + container in sync. flock
//               works across this bind mount because Docker bind mounts
//               share the underlying inode with the host filesystem.
//
// CODEX-SESSION wrapper paths
//   ~/.config/codex-session     — profiles, settings layers, config.toml.
//   ~/.cache/codex-session      — runtime settings cache (rw).
//   ~/.local/state/codex-session
//                               — session directories (one per terminal),
//                                 written by the wrapper at startup.
//   ~/.agents                   — agent "skills" tree (the codex twins:
//                                 $ask, $gc, $review-code-deep, ...) that
//                                 codex loads. Stowed by `dots codex-session`.
//
// The wrapper binary itself does NOT need a mount here: the `base`
// layer already exposes ~/.local/bin (and via PATH the user's
// ~/.cargo/bin) to the container, so `codex-session` is reachable
// as-is. Codex-session emits its shell completion on demand via
// `codex-session completion <shell>`, so there's no static completion
// file to mount either.
// =============================================================================
{
  "mounts": [
    {
      "source": "${localEnv:HOME}/.codex",
      "target": "${localEnv:HOME}/.codex",
      "type": "bind"
    },
    {
      "source": "${localEnv:HOME}/.config/codex-session",
      "target": "${localEnv:HOME}/.config/codex-session",
      "type": "bind"
    },
    {
      "source": "${localEnv:HOME}/.cache/codex-session",
      "target": "${localEnv:HOME}/.cache/codex-session",
      "type": "bind"
    },
    {
      "source": "${localEnv:HOME}/.local/state/codex-session",
      "target": "${localEnv:HOME}/.local/state/codex-session",
      "type": "bind"
    },
    {
      "source": "${localEnv:HOME}/.agents",
      "target": "${localEnv:HOME}/.agents",
      "type": "bind"
    }
  ]
}
