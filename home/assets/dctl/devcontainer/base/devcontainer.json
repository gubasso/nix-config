// =============================================================================
// BASE LAYER — shared infrastructure for every dctl-managed devcontainer
// =============================================================================
//
// This is the shared-infra layer at the root of every manifest's layer stack.
// It sets remoteUser, init, shutdownAction, terminal env, and the universal
// bind mounts that every container needs (gitconfig, gh/glab CLIs).
//
// -----------------------------------------------------------------------------
// Host binary directories: why ~/.cargo/bin and ~/.local/bin are mounted
// differently
// -----------------------------------------------------------------------------
//
// GOAL
// ----
// Make host-installed user binaries available inside every container — both
// cargo-installed tools (~/.cargo/bin/*) and hand-authored scripts
// (~/.local/bin/*) — without breaking image-provided tooling.
//
// Two different strategies are used because the two directories have
// different collision risk with the container image. Summary table:
//
//   Host dir              Container target                PATH handling
//   ~/.cargo/bin     →    ~/.local/host-cargo-bin         append via
//                                                         containerEnv.PATH
//   ~/.local/bin     →    ~/.local/bin  (same path)       prepend via
//                                                         remoteEnv.PATH
//   ~/.local/lib     →    ~/.local/lib  (same path)       not on PATH; holds
//                                                         symlink targets for
//                                                         ~/.local/bin links
//
// Both mounts are readonly:true. The host is the source of truth for these
// binaries; the container must never write back.
//
// -----------------------------------------------------------------------------
// Why ~/.cargo/bin is NOT bind-mounted at the same path
// -----------------------------------------------------------------------------
//
// User CLIs come from the Nix profile (~/.local/state/nix/profile/bin, prepended
// to PATH by remoteEnv below + nix.sh); the image's ~/.cargo/bin is empty. Host ~/.cargo/bin is redirected to
// ~/.local/host-cargo-bin and APPENDED to PATH, so host-installed cargo tools are
// a low-priority fallback that never shadows the Nix-provided tools.
//
// A Docker bind mount OVERLAYS the mount target, so a same-path bind of host
// ~/.cargo/bin onto the container's ~/.cargo/bin would let host binaries take
// over that dir. The redirect + append avoids two problems:
//
//   1. glibc skew. Host binaries link against the host toolchain's glibc; the
//      container image is a different environment. Most rust binaries are
//      static-friendly, but rust-analyzer dlopens proc-macro DSOs that break
//      across glibc versions — appending keeps the Nix/container tools ahead.
//
//   2. Toolchain precedence. Rust toolchains come from each project's Nix flake
//      devShell (oxalica rust-overlay reading rust-toolchain.toml). Appending
//      host cargo/rustup binaries keeps them behind the flake toolchain.
//
// THE FIX
// -------
// Mount host ~/.cargo/bin at a different path — ~/.local/host-cargo-bin — so it
// does NOT overlay the container's ~/.cargo/bin. Then APPEND that directory to
// PATH via remoteEnv (NOT containerEnv — see below):
//
//     "PATH": "${containerEnv:PATH}:${localEnv:HOME}/.local/host-cargo-bin"
//
// Append (not prepend) keeps Nix/container tools ahead; host-only extras (a
// custom `cargo-my-tool` the container lacks) fill the gap via the appended dir.
//
// IMPORTANT: The ${containerEnv:PATH} variable is only supported in remoteEnv,
// NOT in containerEnv. Per the devcontainers spec, ${containerEnv:...} requires
// the container to already be running. In containerEnv (applied via docker run
// -e), the container doesn't exist yet, so the variable is passed as a literal
// string — destroying PATH and causing "sleep: not found" failures.
// See: devcontainers/spec#434, devcontainers/spec#233
//
// -----------------------------------------------------------------------------
// Why ~/.local/bin IS bind-mounted at the same path
// -----------------------------------------------------------------------------
//
// ~/.local/bin is the "user scripts" directory by XDG convention. The agents
// image does NOT keep it on PATH: the image build creates the user with
// useradd and only adds the Nix profile bin via /etc/profile.d (login shells
// only), so non-login shells (dctl ws shell, the lifecycle) get a bare
// system PATH. It must therefore be added to remoteEnv.PATH below (it is), so
// hand-authored scripts resolve. The image build does NOT populate
// ~/.local/bin — it's left empty intentionally for user content. So a
// same-path bind mount has no shadow risk:
//
//   - Nothing to overlay (image contributes zero files to ~/.local/bin).
//   - remoteEnv.PATH points there (see the PATH entry below).
//   - Symmetric with the host: `~/.local/bin/foo` on host is
//     `~/.local/bin/foo` in the container.
//
// This makes hand-authored scripts like claude-session, codex-session
// (and anything else you drop in ~/.local/bin on the host) transparently
// available in every container.
//
// -----------------------------------------------------------------------------
// Why ~/.local/lib IS bind-mounted at the same path (alongside ~/.local/bin)
// -----------------------------------------------------------------------------
//
// Some ~/.local/bin entries are absolute symlinks into ~/.local/lib
// (e.g. ~/.local/bin/cog -> ~/.local/lib/cog/bin/cog). Mounting ~/.local/bin
// alone exposes the symlink but not its target, so the link dangles. A
// same-path readonly bind of ~/.local/lib makes those targets resolve,
// symmetric with the host and with the same low shadow risk (the image
// leaves ~/.local/lib for user content).
//
// -----------------------------------------------------------------------------
// Guidance for future changes
// -----------------------------------------------------------------------------
//
//   - Never change the ~/.cargo/bin target to same-path — it would let host
//     binaries shadow the container/Nix tools (glibc skew, toolchain precedence).
//   - The Nix profile bin is intentionally PREPENDED (it *is* the reproducible
//     toolchain, and profile.d can't be relied on in lifecycle shells — see the
//     PROFILEREAD note by remoteEnv). The rule is about HOST dirs: never change
//     ~/.local/host-cargo-bin from append to prepend — that lets host tools
//     shadow the Nix-provided tools, breaking the reproducible-toolchain model.
//   - Never move PATH back into containerEnv. ${containerEnv:...} is only
//     resolved in remoteEnv; in containerEnv it becomes a literal string.
//   - If you add a third host binary dir, ask: does the image populate the
//     same path? Yes → use the host-* redirect + PATH append pattern.
//                    No  → same-path is fine.
//
// =============================================================================
{
  "name": "${localWorkspaceFolderBasename}-sandbox",
  "image": "devimg/agents:latest",
  "remoteUser": "${localEnv:USER}",
  "updateRemoteUserUID": false,
  "init": true,
  "shutdownAction": "none",
  "containerEnv": {
    "TERM": "${localEnv:TERM}",
    "COLORTERM": "truecolor",
    // Marks a dctl sandbox. rc.d/30-direnv.bash keys off this to eagerly load
    // the project devShell in COMMAND shells (`dctl ws shell <agent>` →
    // `bash -lic "<cmd>"`), where the interactive PROMPT_COMMAND direnv hook
    // never fires. Host shells (no DCTL_SANDBOX) keep the lazy on-`cd` hook.
    "DCTL_SANDBOX": "1"
  },
  "remoteEnv": {
    // Nix-provided user CLIs live in the XDG profile bin and are PREPENDED here
    // (highest priority — this IS the reproducible toolchain). profile.d/nix.sh
    // also prepends it for login shells, BUT /etc/profile only sources
    // /etc/profile.d/*.sh when $PROFILEREAD is unset — and devcontainer lifecycle
    // commands (onCreate/postCreate/ws-run) inherit PROFILEREAD=true from the
    // userEnvProbe login shell, so profile.d is skipped there and nix would be off
    // PATH (this caused `pre-commit: command not found`). Prepending in remoteEnv
    // makes nix CLIs available regardless of profile.d. Host ~/.local/host-cargo-bin
    // stays APPENDED (low-priority fallback; see the ~/.cargo/bin note above).
    "PATH": "${localEnv:HOME}/.local/state/nix/profile/bin:${localEnv:HOME}/.local/bin:${containerEnv:PATH}:${localEnv:HOME}/.local/host-cargo-bin"
  },
  "mounts": [
    {
      "source": "${localEnv:HOME}/.cargo/bin",
      "target": "${localEnv:HOME}/.local/host-cargo-bin",
      "type": "bind",
      "readonly": true
    },
    {
      "source": "${localEnv:HOME}/.local/bin",
      "target": "${localEnv:HOME}/.local/bin",
      "type": "bind",
      "readonly": true
    },
    {
      "source": "${localEnv:HOME}/.local/lib",
      "target": "${localEnv:HOME}/.local/lib",
      "type": "bind",
      "readonly": true
    },
    {
      "source": "${localEnv:HOME}/.gitconfig",
      "target": "${localEnv:HOME}/.gitconfig",
      "type": "bind",
      "readonly": true
    },
    {
      "source": "${localEnv:HOME}/.config/gh",
      "target": "${localEnv:HOME}/.config/gh",
      "type": "bind"
    },
    {
      "source": "${localEnv:HOME}/.config/glab-cli",
      "target": "${localEnv:HOME}/.config/glab-cli",
      "type": "bind"
    }
  ]
}
