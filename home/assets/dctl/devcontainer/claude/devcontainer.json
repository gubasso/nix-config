// =============================================================================
// CLAUDE LAYER — Anthropic Claude Code CLI + host wrapper (claude-session)
// =============================================================================
//
// Single layer covering both the underlying CLI's live state and the host
// `claude-session` wrapper's library/config/state. They are bundled
// here because every container that wants Claude needs both — the wrapper
// drives the underlying CLI and has no value on its own.
//
// All mounts are 1:1 host binds (same path inside and outside the
// container) so any tool that reads/writes these paths Just Works
// without an env override. The host is assumed set up — home-manager
// (claude-session config) and the user's own live CLI state have
// already materialized the paths under HOME.
//
// CLAUDE CODE CLI live state
//   ~/.claude       — directory: project memory, conversation history,
//                     keys to MCP servers, agent settings, ...
//   ~/.claude.json  — top-level CLI config + auth/session file.
//
// CLAUDE-SESSION wrapper paths (see install.sh of the wrapper repo)
//   ~/.local/lib/claude-session  — wrapper library (readonly: host owns).
//                                  The wrapper binary itself lives in
//                                  ~/.local/bin (provided by `base` via
//                                  the readonly ~/.local/bin mount).
//   ~/.config/claude-session     — config.env, profiles/, settings/.
//   ~/.local/state/claude-session
//                                — sessions root + install-manifest (rw).
//
// `~/.local/share/bash-completion/completions/claude-session.bash` is
// intentionally not mounted here: the file only exists if the user has
// run `install.sh --completions-only` on the host, and the bash-
// completion directory is shared with many other tools — leave it to
// the user to wire up if they want completion inside containers.
// =============================================================================
{
  "mounts": [
    {
      "source": "${localEnv:HOME}/.claude",
      "target": "${localEnv:HOME}/.claude",
      "type": "bind"
    },
    {
      "source": "${localEnv:HOME}/.claude.json",
      "target": "${localEnv:HOME}/.claude.json",
      "type": "bind"
    },
    {
      "source": "${localEnv:HOME}/.local/lib/claude-session",
      "target": "${localEnv:HOME}/.local/lib/claude-session",
      "type": "bind",
      "readonly": true
    },
    {
      "source": "${localEnv:HOME}/.config/claude-session",
      "target": "${localEnv:HOME}/.config/claude-session",
      "type": "bind"
    },
    {
      "source": "${localEnv:HOME}/.local/state/claude-session",
      "target": "${localEnv:HOME}/.local/state/claude-session",
      "type": "bind"
    }
  ]
}
