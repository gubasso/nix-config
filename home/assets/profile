# ~/.profile - Fallback for TTY-only sessions (SSH, VT)
# Primary source: ~/.config/environment.d/

[ -n "${DOTFILES_PROFILE_LOADED:-}" ] && return 0
export DOTFILES_PROFILE_LOADED=1

# Source environment.d configs for non-systemd sessions
set -a
for f in "$HOME/.config/environment.d"/*.conf; do
    [ -r "$f" ] && . "$f"
done
set +a

# Ruby gem user bin (version-dependent, cached to avoid slow ruby startup)
_gem_cache="$HOME/.cache/gem_bin_path"
_ruby_path=$(command -v ruby 2>/dev/null)
if [ -n "$_ruby_path" ]; then
    # Cache valid if: exists AND newer than ruby binary AND directory exists
    if [ -f "$_gem_cache" ] && [ "$_gem_cache" -nt "$_ruby_path" ]; then
        read -r _gem_bin <"$_gem_cache"
        if [ -d "$_gem_bin" ]; then
            PATH="$_gem_bin:$PATH"
        else
            # Stale cache (directory missing) - remove and fall through
            rm -f "$_gem_cache"
        fi
    fi
    # Regenerate if cache missing/stale
    if [ ! -f "$_gem_cache" ] || [ "$_gem_cache" -ot "$_ruby_path" ]; then
        # Use Gem.user_dir (where user gems are installed)
        _gem_user_dir=$(ruby -e 'puts Gem.user_dir' 2>/dev/null)
        if [ -n "$_gem_user_dir" ] && [ -d "$_gem_user_dir/bin" ]; then
            mkdir -p "$HOME/.cache"
            echo "$_gem_user_dir/bin" >"$_gem_cache"
            PATH="$_gem_user_dir/bin:$PATH"
        fi
        unset _gem_user_dir
    fi
    unset _gem_bin
fi
unset _gem_cache _ruby_path

# TTY-only settings (not needed in graphical sessions)
export SUDO_EDITOR=nvim
export SYSTEMD_EDITOR=nvim
