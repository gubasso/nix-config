[global]
    monitor = 0
    follow = mouse

    width = (300, 400)
    height = 300
    origin = top-right
    offset = 20x20
    notification_limit = 5

    progress_bar = true
    indicate_hidden = true

    padding = 12
    horizontal_padding = 16
    text_icon_padding = 16
    frame_width = 2
    frame_color = "#2C094C"
    gap_size = 4
    separator_color = frame

    font = monospace 10
    markup = full
    format = "<b>%s</b>\n%b"
    alignment = left
    show_age_threshold = 30
    ellipsize = end

    icon_position = left
    max_icon_size = 48

    corner_radius = 4

    mouse_left_click = close_current
    mouse_right_click = close_all
    mouse_middle_click = do_action

[urgency_low]
    background = "#110326"
    foreground = "#D9CCE8"
    frame_color = "#2C094C"
    timeout = 5

[urgency_normal]
    background = "#16042D"
    foreground = "#F5F0FF"
    frame_color = "#C89DEA"
    timeout = 10

[urgency_critical]
    background = "#16042D"
    foreground = "#F5F0FF"
    frame_color = "#FF4D8D"
    timeout = 0
