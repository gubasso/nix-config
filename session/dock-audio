#!/bin/bash
# Restore the ThinkPad P1 Gen 7 HDA profile after the dock changes audio state.

set -euo pipefail

TARGET_PROFILE="HiFi (HDMI1, HDMI2, HDMI3, Mic1, Mic2, Speaker)"
TARGET_DEVICE_NAME="alsa_card.pci-0000_00_1f.3-platform-skl_had_dsp_generic"
TARGET_OBJECT_PATH="alsa:acp:sofhdadsp"

for _ in {1..20}; do
  if pactl info >/dev/null 2>&1; then
    break
  fi
  sleep 0.5
done

pactl info >/dev/null 2>&1 || exit 0

cards=$(pactl list cards 2>/dev/null || true)
[[ -n "$cards" ]] || exit 0

card_name=$(
  awk -v target_device="$TARGET_DEVICE_NAME" \
    -v target_path="$TARGET_OBJECT_PATH" \
    -v target_profile="$TARGET_PROFILE" '
      /^Card #/ {
        if (name && (matched_device || matched_path || matched_profile)) {
          print name
          found = 1
          exit
        }
        name = ""
        matched_device = matched_path = matched_profile = 0
      }
      /^[[:space:]]*Name:/ {
        name = $2
      }
      $0 ~ "device.name = \"" target_device "\"" {
        matched_device = 1
      }
      $0 ~ "object.path = \"" target_path "\"" {
        matched_path = 1
      }
      index($0, target_profile) {
        matched_profile = 1
      }
      END {
        if (!found && name && (matched_device || matched_path || matched_profile)) {
          print name
        }
      }
    ' <<<"$cards"
)

[[ -n "$card_name" ]] || exit 0

if ! awk -v card="$card_name" -v profile="$TARGET_PROFILE" '
  /^[[:space:]]*Name:/ { in_card = ($2 == card) }
  in_card && index($0, profile) { found = 1 }
  END { exit found ? 0 : 1 }
' <<<"$cards"; then
  exit 0
fi

pactl set-card-profile "$card_name" "$TARGET_PROFILE" >/dev/null 2>&1 || exit 0

speaker_sink=$(
  pactl list short sinks 2>/dev/null |
    awk '/speaker|Speaker|analog-stereo|HiFi/ { print $2; exit }' ||
    true
)

if [[ -n "${speaker_sink:-}" ]]; then
  pactl set-default-sink "$speaker_sink" >/dev/null 2>&1 || true
fi

exit 0
